source "https://rubygems.org"

# Built by GitHub Actions (.github/workflows/pages.yml) rather than the
# github-pages gem, which runs in safe mode and ignores _plugins/.
gem "jekyll", "~> 3.10"

group :jekyll_plugins do
  gem "jekyll-feed"
  gem "jekyll-paginate"
  gem "jekyll-remote-theme"
end

gem "kramdown-parser-gfm"

# No longer default gems in Ruby 3.4
gem "webrick"
gem "base64"
gem "bigdecimal"
gem "csv"
gem "logger"
